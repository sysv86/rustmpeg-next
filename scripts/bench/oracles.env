# SPDX-License-Identifier: Apache-2.0
#
# Pinned benchmark oracles.  These are built or installed outside the
# repository and are only used as black-box comparison tools.  Nothing in this
# file is linked into rustmpeg.
#
# Update a pin only together with docs/benchmarks/BENCHMARK.md, because a
# changed oracle version invalidates comparisons with older runs.

ORACLE_SVT_AV1_REF="v4.2.0"
ORACLE_SVT_AV1_COMMIT="9292ec8e32bce26f781f277ec8739b53426c4300"

# AOMedia AVM reference software; v1.0.0 is the AV2 reference release.
ORACLE_AVM_REF="v1.0.0"
ORACLE_AVM_COMMIT="966a7d7cd6fcf60360caf5dc413b2aeeb65e144d"

# dav2d has no stable matching release for AVM v1.0.0 yet, so it is pinned by
# commit.  The commit is from the canonical VideoLAN GitLab repository.
ORACLE_DAV2D_REF="d7df54181eed81927d7c82cf8b3e54804c3813b4"

ORACLE_LIBC3_REF="v1.1.3"
ORACLE_LIBC3_COMMIT="96a3af0beb5487aca3b98a4b992a539a1f6d80d1"

# System packages installed by the workflow / documented in the README.
ORACLE_FFMPEG_REF="system-apt"
ORACLE_FLAC_REF="system-apt"
